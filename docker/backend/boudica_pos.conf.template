### Boudica POS runtime config — generated by entrypoint.sh from environment variables.
### Local/dev container only. See docker/README.md for what each value means.
### NOTE: this parser (main.cpp get_configuration()) matches "\nkey " literally,
### so every key below must be followed by exactly one space, even when the value is empty.

server ${DB_HOST}
port ${DB_PORT}
username store
password ${STORE_DB_PASSWORD}
database postgres
roles dbrole
roles_password ${STORE_DB_PASSWORD}
roles_chain roles
server_whitelist localhost
epos_user ${ADMIN_USERNAME}
epos_password ${ADMIN_PASSWORD}
reward_point 1
stripe_secret_key ${STRIPE_SECRET_KEY}
boudica_host ${BOUDICA_HOST}
boudica_port ${BOUDICA_PORT}
boudica_api_key ${BOUDICA_API_KEY}
